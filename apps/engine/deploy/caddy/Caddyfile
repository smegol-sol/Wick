# Reverse proxy on the tailnet only (ADR-0009 §3). Plain HTTP inside
# WireGuard; the compose file binds this listener to the Tailscale IP.
:80 {
	@unauth not header Authorization "Bearer {env.DASHBOARD_TOKEN}"

	handle_path /grafana/* {
		reverse_proxy grafana:3000
	}

	handle /prometheus/* {
		respond @unauth 401
		reverse_proxy prometheus:9090
	}

	# Engine API and metrics. /healthz stays open for the phone's quick check.
	handle /healthz {
		reverse_proxy engine:9464
	}
	handle /metrics {
		respond @unauth 401
		reverse_proxy engine:9464
	}
	handle /api/* {
		respond @unauth 401
		reverse_proxy engine:9464
	}
	handle /ws {
		respond @unauth 401
		reverse_proxy engine:9464
	}

	handle {
		respond "wick" 200
	}
}
