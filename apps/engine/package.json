{
  "name": "@wick/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WICK autonomous engine: ingest, features, decision, gates, executor, evaluator.",
  "scripts": {
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/main.ts",
    "migrate": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ../../scripts/test-loader.mjs --test 'src/**/*.test.ts'",
    "vault:init": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/executor/vault-init.ts",
    "replay": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/replay/cli.ts"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@wick/core": "0.1.0",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "ws": "^8.18.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1"
  }
}
