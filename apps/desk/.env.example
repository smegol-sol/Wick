# Server-only. Never prefix these with VITE_ (that would ship them to the browser).

# Dedicated Solana RPC (Helius, Triton, QuickNode, ...). Strongly recommended:
# the public endpoints are rate-limited, slow, and unfit for sniping.
# Also unlocks holder counts (getProgramAccounts) on token pages.
SOLANA_RPC_URL=

# Optional: DexScreener needs no key. Jupiter lite-api needs no key.

# Optional: Vite dev server bind (defaults 127.0.0.1:8080).
# HOST=0.0.0.0
# PORT=8080

# Optional: nitro deploy preset (defaults to vercel). e.g. node-server
# NITRO_PRESET=node-server
