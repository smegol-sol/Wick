  },
  "dependencies": {
    "@wick/core": "0.1.0",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
