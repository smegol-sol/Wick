# Copy to .env next to docker-compose.yml. Never commit .env.

# Postgres password for the `wick` role (generate: openssl rand -hex 24)
POSTGRES_PASSWORD=

# Dedicated Solana RPC (Helius, Triton, QuickNode). Public RPCs are unfit for anything but a smoke run.
SOLANA_RPC_URL=
# WebSocket endpoint for the log stream (logsSubscribe). Derived from SOLANA_RPC_URL when empty.
SOLANA_WS_URL=
# pump.fun migration authority; its transactions are the migrate events. Override only if it rotates.
PUMP_MIGRATION_AUTHORITY=39azUYFWPz3VHgKCf3VChUwbpURdCHRxjWVowf5jUJjg

# Dead-man switch (healthchecks.io ping URL). The engine POSTs every minute; a missed ping alerts from outside.
HEALTHCHECK_URL=
# Separate check for the nightly backup.
HEALTHCHECK_BACKUP_URL=

# Telegram bot for Alertmanager (ADR-0009). Chat id is your own chat with the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Grafana admin
GRAFANA_USER=wick
GRAFANA_PASSWORD=

# Tailscale: the VPS's tailnet IPv4 (tailscale ip -4) and its MagicDNS name.
TAILSCALE_IP=100.64.0.1
TAILSCALE_HOSTNAME=wick

# Bearer token the PWA sends until passkeys land in Phase 5 (generate: openssl rand -hex 32)
DASHBOARD_TOKEN=

LOG_LEVEL=info
BACKUP_KEEP_DAYS=14
